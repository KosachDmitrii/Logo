OPENAI_API_KEY=
RECRAFT_API_KEY=
GEMINI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=logo-files

# Temporary: Local Studio identity in production (until real login).
# Set to 1 on Railway so the studio works without ChatGPT sign-in.
ALLOW_LOCAL_STUDIO=

# Frontend API base (baked into the client at build time)
NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_API_URL=https://logo-production-043e.up.railway.app/api

# Optional: keep NEXT_PUBLIC_API_URL=/api and proxy local /api → Railway
# (same-origin, no CORS). Restart `next dev` after changing.
# API_PROXY_TARGET=https://logo-production-043e.up.railway.app

# Required on Railway when the browser calls the API from another origin
# (e.g. local UI with absolute NEXT_PUBLIC_API_URL).
# CORS_ALLOWED_ORIGINS=http://localhost:3000
