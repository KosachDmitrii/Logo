OPENAI_API_KEY=
RECRAFT_API_KEY=
GEMINI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=logo-files

# Public site origin for magic-link redirects + Stripe return URLs.
# Must match the host where the browser stores auth cookies.
# Local: http://localhost:3000
# Railway: https://your-app.up.railway.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary shared Local Studio identity (local@loopen.dev).
# =1 to bypass magic link. =0 or empty → real Enter / email auth required.
# Remove before public launch (shared identity).
ALLOW_LOCAL_STUDIO=

# Stripe (optional until billing goes live — welcome signals still work).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local UI → Railway API (recommended). Restart `next dev` after changing.
# Keep NEXT_PUBLIC_API_URL=/api so the browser stays same-origin (no CORS).
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=https://logo-production-043e.up.railway.app

# Alternative: browser → Railway directly (CORS). Do NOT use with API_PROXY_TARGET.
# NEXT_PUBLIC_API_URL=https://logo-production-043e.up.railway.app/api
# CORS_ALLOWED_ORIGINS=http://localhost:3000
